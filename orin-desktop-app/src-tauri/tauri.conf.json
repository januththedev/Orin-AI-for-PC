{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orin Code",
  "version": "0.1.0",
  "identifier": "ai.orin.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orin Code",
        "width": 1400,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.png"
    ]
  }
}
